generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  WRITER
  EDITOR
  ARTIST
  LETTERER
  TRANSLATOR
  PRODUCER
  VIEWER
}

enum SeriesStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Genre {
  ACTION
  COMEDY
  DRAMA
  FANTASY
  HORROR
  MYSTERY
  ROMANCE
  SCI_FI
  SLICE_OF_LIFE
}

enum CanonStatus {
  DRAFT
  APPROVED
  DEPRECATED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  profile      Profile?
  memberships  WorkspaceMember[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  members   WorkspaceMember[]
  series    Series[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Series {
  id          String       @id @default(cuid())
  workspaceId String
  title       String
  slug        String
  logline     String
  synopsis    String
  genre       Genre
  language    String
  audience    String
  status      SeriesStatus @default(DRAFT)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  characters  Character[]
  locations   Location[]
  worldRules  WorldRule[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@unique([workspaceId, slug])
  @@index([workspaceId, deletedAt])
}

model Character {
  id          String      @id @default(cuid())
  seriesId    String
  name        String
  aliases     String      @default("")
  pronouns    String      @default("")
  role        String
  lifeStage   String      @default("")
  appearance  String      @default("")
  personality String      @default("")
  speechStyle String      @default("")
  motivations String      @default("")
  goals       String      @default("")
  fears       String      @default("")
  secrets     String      @default("")
  canonStatus CanonStatus @default(DRAFT)
  locationId  String?
  series      Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  location    Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([seriesId, deletedAt])
}

model Location {
  id          String      @id @default(cuid())
  seriesId    String
  name        String
  description String      @default("")
  canonStatus CanonStatus @default(DRAFT)
  series      Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  characters  Character[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@unique([seriesId, name])
  @@index([seriesId, deletedAt])
}

model WorldRule {
  id          String      @id @default(cuid())
  seriesId    String
  title       String
  description String
  canonStatus CanonStatus @default(DRAFT)
  series      Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([seriesId, deletedAt])
}
