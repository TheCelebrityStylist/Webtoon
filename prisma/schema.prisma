generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  WRITER
  EDITOR
  ARTIST
  LETTERER
  TRANSLATOR
  PRODUCER
  VIEWER
}

enum SeriesStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Genre {
  ACTION
  COMEDY
  DRAMA
  FANTASY
  HORROR
  MYSTERY
  ROMANCE
  SCI_FI
  SLICE_OF_LIFE
}

enum CanonStatus {
  DRAFT
  PROPOSED
  CANON
  DEPRECATED
  ALTERNATE
  ARCHIVED
}

enum ProjectType {
  NOVEL
  SCREENPLAY
  WEBTOON
  SERIAL_FICTION
  COMIC
  NARRATIVE_DESIGN
}

enum PointOfView {
  FIRST_PERSON
  SECOND_PERSON
  THIRD_LIMITED
  THIRD_OMNISCIENT
  MULTIPLE
}

enum NarrativeTense {
  PAST
  PRESENT
  MIXED
}

enum AiDecision {
  PENDING
  ACCEPTED
  REJECTED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model User {
  id            String                  @id @default(cuid())
  email         String                  @unique
  passwordHash  String
  profile       Profile?
  memberships   WorkspaceMember[]
  integrations  IntegrationConnection[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model IntegrationConnection {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  accountEmail          String?
  encryptedRefreshToken String
  grantedScopes         String[]
  lastSyncedAt          DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  revokedAt             DateTime?

  @@unique([userId, provider])
  @@index([userId, revokedAt])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  interfaceLocale String   @default("en")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  members   WorkspaceMember[]
  series    Series[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Series {
  id               String             @id @default(cuid())
  workspaceId      String
  title            String
  slug             String
  logline          String
  synopsis         String
  genre            Genre
  language         String
  audience         String
  projectType      ProjectType        @default(NOVEL)
  regionalVariant  String             @default("en-US")
  pointOfView      PointOfView        @default(THIRD_LIMITED)
  narrativeTense   NarrativeTense     @default(PAST)
  premise          String             @default("")
  status           SeriesStatus       @default(DRAFT)
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  characters       Character[]
  locations        Location[]
  worldRules       WorldRule[]
  chapters         Chapter[]
  aiSuggestions    AiSuggestion[]
  branches         StoryBranch[]
  continuityFacts  ContinuityFact[]
  continuityIssues ContinuityIssue[]
  timelineEvents   TimelineEvent[]
  storyObjects     StoryObject[]
  plotThreads      PlotThread[]
  promises         NarrativePromise[]
  revisionFindings RevisionFinding[]
  imports          ImportJob[]
  exports          ExportJob[]
  canonUniverse    CanonUniverse?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  @@unique([workspaceId, slug])
  @@index([workspaceId, deletedAt])
}

model CanonUniverse {
  id           String             @id @default(cuid())
  seriesId     String             @unique
  version      Int                @default(0)
  metadata     Json               @default("{}")
  series       Series             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  entities     CanonEntity[]
  moments      CanonMoment[]
  facts        CanonFact[]
  edges        CanonEdge[]
  branches     CanonBranch[]
  analysisRuns CanonAnalysisRun[]
  commits      CanonCommit[]
  dependencies CanonDependency[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CanonEntity {
  id          String            @id @default(cuid())
  universeId  String
  entityType  String
  customType  String?
  name        String
  status      String            @default("ACTIVE")
  confidence  Float             @default(1)
  metadata    Json              @default("{}")
  sourceType  String?
  sourceId    String?
  universe    CanonUniverse     @relation(fields: [universeId], references: [id], onDelete: Cascade)
  transitions CanonTransition[]
  outgoing    CanonEdge[]       @relation("CanonEdgeFrom")
  incoming    CanonEdge[]       @relation("CanonEdgeTo")
  mentions    CanonMention[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@unique([universeId, sourceType, sourceId])
  @@index([universeId, entityType, deletedAt])
  @@index([universeId, name])
}

model CanonMoment {
  id              String            @id @default(cuid())
  universeId      String
  branchId        String?
  sceneId         String?
  sequence        Int
  label           String
  occurredAt      DateTime?
  manuscriptOrder Int?
  readerOrder     Int?
  metadata        Json              @default("{}")
  universe        CanonUniverse     @relation(fields: [universeId], references: [id], onDelete: Cascade)
  branch          CanonBranch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  transitions     CanonTransition[]
  facts           CanonFact[]
  mentions        CanonMention[]
  createdAt       DateTime          @default(now())

  @@unique([universeId, branchId, sequence])
  @@index([universeId, occurredAt])
  @@index([sceneId])
}

model CanonTransition {
  id           String            @id @default(cuid())
  entityId     String
  momentId     String
  property     String
  beforeValue  Json?
  afterValue   Json
  evidence     Json
  confidence   Float             @default(1)
  status       String            @default("CONFIRMED")
  supersedesId String?
  entity       CanonEntity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  moment       CanonMoment       @relation(fields: [momentId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  commitItems  CanonCommitItem[]

  @@index([entityId, property, momentId])
  @@index([momentId, status])
}

model CanonFact {
  id                  String        @id @default(cuid())
  universeId          String
  momentId            String
  subjectEntityId     String?
  perspective         String
  perspectiveEntityId String?
  predicate           String
  value               Json
  evidence            Json
  confidence          Float         @default(1)
  importance          String        @default("NORMAL")
  status              String        @default("CONFIRMED")
  universe            CanonUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)
  moment              CanonMoment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([universeId, perspective, perspectiveEntityId, predicate])
  @@index([subjectEntityId, predicate])
  @@index([momentId, status])
}

model CanonEdge {
  id           String        @id @default(cuid())
  universeId   String
  fromEntityId String
  toEntityId   String
  edgeType     String
  metadata     Json          @default("{}")
  confidence   Float         @default(1)
  status       String        @default("ACTIVE")
  universe     CanonUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)
  fromEntity   CanonEntity   @relation("CanonEdgeFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     CanonEntity   @relation("CanonEdgeTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([universeId, fromEntityId, toEntityId, edgeType])
  @@index([toEntityId, edgeType])
}

model CanonBranch {
  id           String        @id @default(cuid())
  universeId   String
  name         String
  parentId     String?
  forkSequence Int
  active       Boolean       @default(false)
  universe     CanonUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)
  moments      CanonMoment[]
  createdAt    DateTime      @default(now())

  @@unique([universeId, name])
}

model Chapter {
  id        String    @id @default(cuid())
  seriesId  String
  title     String
  number    Int
  kind      String    @default("CHAPTER")
  series    Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scenes    Scene[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([seriesId, number])
  @@index([seriesId, deletedAt])
}

model Scene {
  id                String              @id @default(cuid())
  chapterId         String
  title             String
  position          Int
  purpose           String              @default("")
  conflict          String              @default("")
  stakes            String              @default("")
  outcome           String              @default("")
  manuscriptJson    Json                @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  manuscriptText    String              @default("")
  revision          Int                 @default(0)
  chapter           Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  beats             StoryBeat[]
  versions          ManuscriptVersion[]
  aiSuggestions     AiSuggestion[]
  continuityFacts   ContinuityFact[]
  continuityIssues  ContinuityIssue[]
  timelineEvents    TimelineEvent[]
  revisionFindings  RevisionFinding[]
  canonAnalysisRuns CanonAnalysisRun[]
  canonMentions     CanonMention[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  @@unique([chapterId, position])
  @@index([chapterId, deletedAt])
}

model StoryBeat {
  id          String      @id @default(cuid())
  sceneId     String
  position    Int
  type        String
  summary     String
  canonStatus CanonStatus @default(DRAFT)
  scene       Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([sceneId, position])
}

model CanonAnalysisRun {
  id             String          @id @default(cuid())
  universeId     String
  sceneId        String
  requestedById  String
  requestId      String
  revision       Int
  manuscriptHash String
  provider       String
  model          String?
  status         String          @default("PENDING")
  inputSummary   Json
  warning        String?
  universe       CanonUniverse   @relation(fields: [universeId], references: [id], onDelete: Cascade)
  scene          Scene           @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  proposals      CanonProposal[]
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  @@unique([sceneId, requestId])
  @@index([universeId, sceneId, revision])
  @@index([requestedById, createdAt])
}

model CanonProposal {
  id             String            @id @default(cuid())
  runId          String
  kind           String
  entityType     String?
  entityName     String?
  entityId       String?
  property       String?
  beforeValue    Json?
  afterValue     Json?
  evidence       Json
  confidence     Float
  perspective    String            @default("OBJECTIVE")
  status         String            @default("PENDING")
  resolutionNote String?
  run            CanonAnalysisRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  commitItems    CanonCommitItem[]
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([runId, status])
  @@index([entityId, property])
}

model CanonMention {
  id          String       @id @default(cuid())
  sceneId     String
  entityId    String
  momentId    String?
  blockId     String
  quote       String
  startOffset Int
  endOffset   Int
  revision    Int
  active      Boolean      @default(true)
  scene       Scene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  entity      CanonEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  moment      CanonMoment? @relation(fields: [momentId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([sceneId, blockId, revision])
  @@index([entityId, sceneId])
}

model CanonCommit {
  id               String            @id @default(cuid())
  universeId       String
  requestedById    String
  expectedVersion  Int
  resultingVersion Int
  status           String            @default("APPLIED")
  revertedAt       DateTime?
  revertedById     String?
  universe         CanonUniverse     @relation(fields: [universeId], references: [id], onDelete: Cascade)
  items            CanonCommitItem[]
  createdAt        DateTime          @default(now())

  @@index([universeId, createdAt])
  @@index([requestedById])
}

model CanonCommitItem {
  id           String           @id @default(cuid())
  commitId     String
  proposalId   String
  transitionId String?
  recordType   String
  recordId     String
  beforeValue  Json?
  afterValue   Json?
  commit       CanonCommit      @relation(fields: [commitId], references: [id], onDelete: Cascade)
  proposal     CanonProposal    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  transition   CanonTransition? @relation(fields: [transitionId], references: [id], onDelete: SetNull)

  @@unique([commitId, proposalId])
  @@index([recordType, recordId])
}

model CanonDependency {
  id               String        @id @default(cuid())
  universeId       String
  sourceRecordType String
  sourceRecordId   String
  targetRecordType String
  targetRecordId   String
  consequenceClass String
  severity         String
  evidence         Json
  active           Boolean       @default(true)
  universe         CanonUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@unique([universeId, sourceRecordType, sourceRecordId, targetRecordType, targetRecordId])
  @@index([universeId, targetRecordType, targetRecordId, active])
  @@index([sourceRecordType, sourceRecordId, active])
}

model ManuscriptVersion {
  id             String   @id @default(cuid())
  sceneId        String
  userId         String
  revision       Int
  manuscriptJson Json
  manuscriptText String
  scene          Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([sceneId, revision])
  @@index([userId])
}

model SceneMutation {
  id         String   @id @default(cuid())
  userId     String
  sceneId    String
  mutationId String
  revision   Int
  createdAt  DateTime @default(now())

  @@unique([userId, mutationId])
  @@index([sceneId, createdAt])
}

model OAuthState {
  id         String    @id @default(cuid())
  userId     String
  nonceHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AiSuggestion {
  id               String     @id @default(cuid())
  seriesId         String
  sceneId          String
  requestedById    String
  operation        String
  requestedLocale  String
  contextRecordIds String[]
  result           Json
  explanation      String
  model            String
  promptVersion    String
  decision         AiDecision @default(PENDING)
  series           Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scene            Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())
  decidedAt        DateTime?

  @@index([seriesId, sceneId])
}

model Character {
  id          String               @id @default(cuid())
  seriesId    String
  name        String
  aliases     String               @default("")
  pronouns    String               @default("")
  role        String
  lifeStage   String               @default("")
  appearance  String               @default("")
  personality String               @default("")
  speechStyle String               @default("")
  motivations String               @default("")
  goals       String               @default("")
  fears       String               @default("")
  secrets     String               @default("")
  canonStatus CanonStatus          @default(DRAFT)
  locationId  String?
  series      Series               @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  location    Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  states      CharacterState[]
  knowledge   CharacterKnowledge[]
  beliefs     CharacterBelief[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  @@index([seriesId, deletedAt])
}

model Location {
  id          String      @id @default(cuid())
  seriesId    String
  name        String
  description String      @default("")
  canonStatus CanonStatus @default(DRAFT)
  series      Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  characters  Character[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@unique([seriesId, name])
  @@index([seriesId, deletedAt])
}

model WorldRule {
  id          String      @id @default(cuid())
  seriesId    String
  title       String
  description String
  canonStatus CanonStatus @default(DRAFT)
  series      Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([seriesId, deletedAt])
}

model Plan {
  id              String         @id @default(cuid())
  key             String         @unique
  name            String
  stripeProductId String         @unique
  monthlyPriceId  String         @unique
  annualPriceId   String         @unique
  entitlements    Json
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  stripeCustomerId     String             @unique
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
}

model StripeEvent {
  id          String    @id
  type        String
  livemode    Boolean
  payloadHash String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

model StoryBranch {
  id            String   @id @default(cuid())
  seriesId      String
  name          String
  sourceVersion String?
  active        Boolean  @default(false)
  series        Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([seriesId, name])
}

model CharacterState {
  id          String    @id @default(cuid())
  characterId String
  sceneId     String?
  kind        String
  value       Json
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, kind, validTo])
}

model CharacterKnowledge {
  id            String    @id @default(cuid())
  characterId   String
  factKey       String
  value         String
  sourceSceneId String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@unique([characterId, factKey, sourceSceneId])
}

model CharacterBelief {
  id            String    @id @default(cuid())
  characterId   String
  factKey       String
  belief        String
  confidence    Float     @default(1)
  sourceSceneId String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@unique([characterId, factKey, sourceSceneId])
}

model ContinuityFact {
  id          String   @id @default(cuid())
  seriesId    String
  sceneId     String
  subjectType String
  subjectId   String?
  predicate   String
  value       Json
  truthStatus String
  sourceQuote String
  intentional Boolean  @default(false)
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([seriesId, subjectType, subjectId, predicate])
  @@index([sceneId])
}

model ContinuityIssue {
  id              String    @id @default(cuid())
  seriesId        String
  sceneId         String
  category        String
  importance      String
  confidence      Float
  passage         String
  explanation     String
  evidence        Json
  affectedRecords Json
  status          String    @default("OPEN")
  resolution      String?
  series          Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scene           Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([seriesId, status, importance])
  @@index([sceneId, status])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  seriesId    String
  sceneId     String?
  title       String
  chronology  Int
  occurredAt  DateTime?
  durationMin Int?
  causeIds    String[]
  series      Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scene       Scene?    @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([seriesId, chronology])
}

model StoryObject {
  id        String        @id @default(cuid())
  seriesId  String
  name      String
  kind      String
  series    Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  states    ObjectState[]
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@unique([seriesId, name])
}

model ObjectState {
  id            String      @id @default(cuid())
  storyObjectId String
  sceneId       String
  ownerId       String?
  locationId    String?
  state         Json
  storyObject   StoryObject @relation(fields: [storyObjectId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([storyObjectId, sceneId])
}

model PlotThread {
  id            String   @id @default(cuid())
  seriesId      String
  title         String
  status        String   @default("OPEN")
  sourceSceneId String
  series        Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([seriesId, status])
}

model NarrativePromise {
  id            String   @id @default(cuid())
  seriesId      String
  setupSceneId  String
  description   String
  status        String   @default("OPEN")
  payoffSceneId String?
  series        Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([seriesId, status])
}

model RevisionFinding {
  id             String   @id @default(cuid())
  seriesId       String
  sceneId        String
  category       String
  importance     String
  confidence     Float
  passage        String
  evidence       Json
  recommendation Json
  status         String   @default("OPEN")
  series         Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  scene          Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([seriesId, status, category])
}

model GoogleDocumentReference {
  id             String    @id @default(cuid())
  userId         String
  seriesId       String
  googleId       String
  kind           String
  title          String
  lastExportedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, googleId])
  @@index([seriesId, kind])
}

model GoogleCalendarReference {
  id         String   @id @default(cuid())
  userId     String
  seriesId   String
  eventId    String
  calendarId String   @default("primary")
  createdAt  DateTime @default(now())

  @@unique([userId, calendarId, eventId])
  @@index([seriesId])
}

model ImportJob {
  id          String    @id @default(cuid())
  seriesId    String
  userId      String
  provider    String
  sourceId    String
  status      JobStatus @default(PENDING)
  mapping     Json?
  result      Json?
  error       String?
  series      Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([seriesId, status])
}

model ExportJob {
  id          String    @id @default(cuid())
  seriesId    String
  userId      String
  format      String
  status      JobStatus @default(PENDING)
  reference   String?
  checksum    String?
  error       String?
  series      Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([seriesId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  seriesId    String?
  action      String
  targetType  String
  targetId    String
  metadata    Json
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([seriesId, createdAt])
}
